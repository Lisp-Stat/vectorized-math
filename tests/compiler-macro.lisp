;;; The compiler macro of VM:+.  + is VM:+ in this package.
(in-package #:vm-tests)

(defsuite compiler-macro-tests (vm-tests))

(defvar *cm-trace* nil)

(defun unwrap-locally (form)
  "Drop the (locally (declare ...) body) wrapper the expansion has on SBCL."
  (if (and (consp form) (eq (car form) 'locally)) (third form) form))

(defun expand-plus (form &optional env)
  (let ((e (funcall (compiler-macro-function 'vm:+) form env)))
    (if (and (consp e) (eq (car e) 'let*))
        `(let* ,(second e) ,(unwrap-locally (third e)))
        (unwrap-locally e))))

(deftest cm-expansion-shapes (compiler-macro-tests)
  (assert-equal 0 (expand-plus '(vm:+)))
  (assert-equal '(cl:+ 1 2) (expand-plus '(vm:+ 1 2)))
  (assert-equal '(cl:+ 1.5d0 (the fixnum x)) (expand-plus '(vm:+ 1.5d0 (the fixnum x))))
  ;; :INTO, funcall shape: declined (the form itself is returned)
  (let ((f '(vm:+ a b :into out))) (assert-true (eq f (expand-plus f))))
  (let ((f '(funcall #'vm:+ 1 2))) (assert-true (eq f (expand-plus f))))
  ;; unknown arguments: an inline number test
  (let ((e (expand-plus '(vm:+ (f a) b))))
    (assert-equal 'let* (first e))
    (assert-equal 'if (first (third e)))))

(deftest cm-declared-variables-expand-to-cl-plus (compiler-macro-tests)
  (let ((r (funcall (compile nil '(lambda (x y z)
                                   (declare (fixnum x) (double-float y) (type (complex single-float) z))
                                   (macrolet ((probe (form &environment env)
                                                `',(expand-plus form env)))
                                     (list (probe (vm:+ x x))
                                           (probe (vm:+ x 1))
                                           (probe (vm:+ y 1d0 (the double-float y)))
                                           (probe (vm:+ z z))
                                           (probe (vm:+ (vm:+ x x) y))
                                           (probe (vm:+ x w))))))
                    1 2d0 #c(1f0 1f0))))
    (assert-equal '(cl:+ x x) (first r))
    (assert-equal '(cl:+ x 1) (second r))
    (assert-equal '(cl:+ y 1d0 (the double-float y)) (third r))
    (assert-equal '(cl:+ z z) (fourth r))
    (assert-equal '(cl:+ (vm:+ x x) y) (fifth r))
    ;; w is not declared: not all known
    (assert-true (eq 'let* (first (sixth r))) )))

(deftest cm-undeclared-variables-are-not-rebound (compiler-macro-tests)
  "Plain variables are referenced directly when no later argument could change them."
  (let ((r (funcall (compile nil '(lambda (a b)
                                   (macrolet ((probe (form &environment env) `',(expand-plus form env)))
                                     (list (probe (vm:+ a b))
                                           (probe (vm:+ a (incf b)))))))
                    1 2)))
    (assert-equal `(if (and ,(vm.impl::number-test 'a) ,(vm.impl::number-test 'b))
                       (cl:+ a b) (vm.impl::plus-general a b))
                  (first r))
    ;; (incf b) comes after A; A must be bound first? a is read before incf b, so a may stay
    ;; only when no later argument is a side-effecting form: here one is, so A is bound.
    (assert-true (eq 'let* (first (second r))))))

(deftest cm-behaviour (compiler-macro-tests)
  "Compiled VM:+ forms behave like the function, including evaluation order."
  (let ((f1 (compile nil '(lambda (x y) (+ x y))))
        (f2 (compile nil '(lambda (x) (+ x)))))
    (assert-equal 3 (funcall f1 1 2))
    (assert-equal 3.5d0 (funcall f1 1 2.5d0))
    (assert-true (array-is (funcall f1 (darr 1d0 2d0) 1) 'double-float 2 '(2d0 3d0)))
    (assert-true (array-is (funcall f1 1 (darr 1d0 2d0)) 'double-float 2 '(2d0 3d0)))
    (assert-equal 5 (funcall f2 5))
    (assert-true (array-is (funcall f2 (darr 1d0)) 'double-float 1 '(1d0)))
    (let ((c (condition-of (funcall f2 'a))))
      (assert-true (typep c 'type-error))
      (assert-true (eq 'a (type-error-datum c)))
      (assert-true (eq 'number (type-error-expected-type c))))
    (let ((c (condition-of (funcall f1 1 "x"))))
      (assert-true (typep c 'type-error))
      (assert-equal "x" (type-error-datum c)))
    ;; zero arguments, :into, funcall
    (assert-equal 0 (funcall (compile nil '(lambda () (+)))))
    (let ((out (darr 0d0 0d0)))
      (funcall (compile nil '(lambda (o) (+ (darr 1d0 2d0) 1d0 :into o))) out)
      (assert-true (array-is out 'double-float 2 '(2d0 3d0))))
    (assert-equal 6 (funcall (compile nil '(lambda () (funcall #'+ 1 2 3)))))
    (assert-equal 6 (funcall (compile nil '(lambda () (apply #'+ '(1 2 3))))))))

(deftest cm-evaluation-order-and-single-evaluation (compiler-macro-tests)
  (let ((f (compile nil '(lambda (x)
                          (let ((trace '()))
                            (let ((r (+ (progn (push 1 trace) x)
                                        (progn (push 2 trace) 10)
                                        (progn (push 3 trace) 100))))
                              (list r (reverse trace)))))))
        (g (compile nil '(lambda (x) (+ x (incf x) (incf x)))))
        (h (compile nil '(lambda (x) (let ((n 0)) (list (+ (progn (incf n) x) (progn (incf n) x)) n))))))
    (assert-equal '(111 (1 2 3)) (funcall f 1))
    (assert-equal 6 (funcall g 1))                     ; 1 + 2 + 3, as CL
    (assert-equal (funcall (compile nil '(lambda (x) (cl:+ x (incf x) (incf x)))) 1) (funcall g 1))
    (assert-equal '(2 2) (funcall h 1))
    ;; array first argument followed by a side effect on the variable holding it
    (let ((a (darr 1d0 2d0)))
      (assert-true (array-is (funcall (compile nil '(lambda (v) (+ v (progn (setq v 5) 1)))) a)
                             'double-float 2 '(2d0 3d0))))))

(deftest cm-symbol-macro-and-special-arguments (compiler-macro-tests)
  (let ((f (compile nil '(lambda (x) (symbol-macrolet ((s (progn (push :s *cm-trace*) x))) (+ s s))))))
    (setf *cm-trace* nil)
    (assert-equal 6 (funcall f 3))
    (assert-equal '(:s :s) *cm-trace*)))

(deftest cm-constants (compiler-macro-tests)
  (assert-equal (cl:+ pi 1) (funcall (compile nil '(lambda () (+ pi 1)))))
  (assert-equal '(cl:+ pi 1) (expand-plus '(vm:+ pi 1))))

;;; ---------------------------------------------------------------------------
;;; The other operators: - * / 1+ 1-

(defun expand-op (name form &optional env)
  (let ((e (funcall (compiler-macro-function name) form env)))
    (if (and (consp e) (eq (car e) 'let*))
        `(let* ,(second e) ,(unwrap-locally (third e)))
        (unwrap-locally e))))

(deftest cm-other-operators-expansion-shapes (compiler-macro-tests)
  ;; arity rules: (*) = 1, (-) and (/) are declined so the runtime error is CL's
  (assert-equal 1 (expand-op 'vm:* '(vm:*)))
  (let ((f '(vm:-))) (assert-true (eq f (expand-op 'vm:- f))))
  (let ((f '(vm:/))) (assert-true (eq f (expand-op 'vm:/ f))))
  (let ((f '(vm:1+))) (assert-true (eq f (expand-op 'vm:1+ f))))
  (let ((f '(vm:1+ a b))) (assert-true (eq f (expand-op 'vm:1+ f))))
  (let ((f '(vm:1- a b c))) (assert-true (eq f (expand-op 'vm:1- f))))
  ;; constants
  (assert-equal '(cl:- 1 2) (expand-op 'vm:- '(vm:- 1 2)))
  (assert-equal '(cl:- 5) (expand-op 'vm:- '(vm:- 5)))
  (assert-equal '(cl:* 2 3 4) (expand-op 'vm:* '(vm:* 2 3 4)))
  (assert-equal '(cl:/ 6 3 2) (expand-op 'vm:/ '(vm:/ 6 3 2)))
  (assert-equal '(cl:/ 2) (expand-op 'vm:/ '(vm:/ 2)))
  (assert-equal '(cl:1+ 5) (expand-op 'vm:1+ '(vm:1+ 5)))
  (assert-equal '(cl:1- 5.5d0) (expand-op 'vm:1- '(vm:1- 5.5d0)))
  ;; :into and funcall shapes are declined
  (dolist (op '(vm:- vm:* vm:/))
    (let ((f `(,op a b :into out))) (assert-true (eq f (expand-op op f))))
    (let ((f `(funcall (function ,op) 1 2))) (assert-true (eq f (expand-op op f)))))
  ;; unknown arguments: an inline number test, then the operator's -general function
  (loop for (op general) in '((vm:- vm.impl::minus-general) (vm:* vm.impl::times-general)
                              (vm:/ vm.impl::divide-general))
        do (let ((e (expand-op op `(,op (f a) b))))
             (assert-equal 'let* (first e))
             (assert-equal 'if (first (third e)))
             (assert-equal general (first (fourth (third e))))))
  (let ((e (expand-op 'vm:1+ '(vm:1+ (f a)))))
    (assert-equal 'let* (first e))
    (assert-equal 'vm.impl::one-plus-general (first (fourth (third e))))))

(deftest cm-other-operators-declared-variables (compiler-macro-tests)
  (let ((r (funcall (compile nil '(lambda (x y z)
                                   (declare (fixnum x) (double-float y) (type (complex single-float) z))
                                   (macrolet ((probe (op form &environment env) `',(expand-op op form env)))
                                     (list (probe vm:- (vm:- x x))
                                           (probe vm:- (vm:- x))
                                           (probe vm:* (vm:* y 2d0 y))
                                           (probe vm:/ (vm:/ z z))
                                           (probe vm:/ (vm:/ y))
                                           (probe vm:1+ (vm:1+ x))
                                           (probe vm:1- (vm:1- y))
                                           (probe vm:* (vm:* (vm:- x 1) (vm:/ y 2)))
                                           (probe vm:- (vm:- x w))))))
                    1 2d0 #c(1f0 1f0))))
    (assert-equal '(cl:- x x) (first r))
    (assert-equal '(cl:- x) (second r))
    (assert-equal '(cl:* y 2d0 y) (third r))
    (assert-equal '(cl:/ z z) (fourth r))
    (assert-equal '(cl:/ y) (fifth r))
    (assert-equal '(cl:1+ x) (sixth r))
    (assert-equal '(cl:1- y) (seventh r))
    (assert-equal '(cl:* (vm:- x 1) (vm:/ y 2)) (eighth r))
    (assert-equal 'let* (first (ninth r)))))

(deftest cm-other-operators-behaviour (compiler-macro-tests)
  "Compiled forms behave like the functions and like CL."
  (flet ((c (form) (compile nil `(lambda (a &optional b) (declare (ignorable a b)) ,form))))
    (let ((sub (c '(- a b))) (mul (c '(* a b))) (div (c '(/ a b)))
          (neg (c '(- a))) (rec (c '(/ a))) (inc (c '(1+ a))) (dec (c '(1- a))))
      (assert-equal 1 (funcall sub 3 2))
      (assert-equal 1.5d0 (funcall sub 3 1.5d0))
      (assert-equal 6 (funcall mul 3 2))
      (assert-equal 3/2 (funcall div 3 2))
      (assert-equal -3 (funcall neg 3))
      (assert-equal 1/3 (funcall rec 3))
      (assert-equal 4 (funcall inc 3))
      (assert-equal 2 (funcall dec 3))
      (assert-true (array-is (funcall sub (darr 3d0 4d0) 1) 'double-float 2 '(2d0 3d0)))
      (assert-true (array-is (funcall sub 1 (darr 3d0 4d0)) 'double-float 2 '(-2d0 -3d0)))
      (assert-true (array-is (funcall mul (darr 3d0 4d0) (darr 2d0 2d0)) 'double-float 2 '(6d0 8d0)))
      (assert-true (array-is (funcall div (iarr 'fixnum 3 4) 2) t 2 '(3/2 2)))
      (assert-true (array-is (funcall neg (darr 3d0 -0d0)) 'double-float 2 '(-3d0 0d0)))
      (assert-true (array-is (funcall rec (darr 4d0 8d0)) 'double-float 2 '(0.25d0 0.125d0)))
      (assert-true (array-is (funcall inc (darr 4d0)) 'double-float 1 '(5d0)))
      (assert-true (array-is (funcall dec (iarr 'fixnum 4)) '(signed-byte 64) 1 '(3)))
      ;; errors: the same type and datum as CL
      (dolist (f (list sub mul div))
        (let ((c (condition-of (funcall f 1 "x"))))
          (assert-true (typep c 'type-error))
          (assert-equal "x" (type-error-datum c)))
        (let ((c (condition-of (funcall f 'q 1))))
          (assert-true (typep c 'type-error))
          (assert-true (eq 'q (type-error-datum c)))))
      (dolist (f (list neg rec inc dec))
        (let ((c (condition-of (funcall f 'q))))
          (assert-true (typep c 'type-error))
          (assert-true (eq 'q (type-error-datum c)))
          (assert-equal 'number (type-error-expected-type c))))
      (assert-true (typep (condition-of (funcall div 1 (opaque 0))) 'division-by-zero))
      (assert-true (typep (condition-of (funcall rec (opaque 0))) 'division-by-zero)))
    ;; zero arguments and wrong counts: the error CL gives (compiled forms must not turn it into something else)
    (assert-equal 1 (funcall (compile nil '(lambda () (*)))))
    (let ((v (condition-of (handler-bind ((warning #'muffle-warning)) (funcall (compile nil '(lambda () (-)))))))
          (c (condition-of (apply #'cl:- (opaque '())))))
      (assert-true (typep v 'error))
      (assert-equal (type-of c) (type-of v)))
    (let ((v (condition-of (handler-bind ((warning #'muffle-warning)) (funcall (compile nil '(lambda () (/)))))))
          (c (condition-of (apply #'cl:/ (opaque '())))))
      (assert-true (typep v 'error))
      (assert-equal (type-of c) (type-of v)))
    (dolist (form '((1+) (1+ 1 2) (1- 1 2)))
      (let ((v (condition-of (handler-bind ((warning #'muffle-warning)) (funcall (compile nil `(lambda () ,form)))))))
        (assert-true (typep v 'error))))
    ;; :into and funcall/apply shapes
    (let ((out (darr 0d0 0d0)))
      (funcall (compile nil '(lambda (o) (- (darr 5d0 6d0) 1d0 :into o))) out)
      (assert-true (array-is out 'double-float 2 '(4d0 5d0)))
      (funcall (compile nil '(lambda (o) (/ (darr 6d0 8d0) 2d0 :into o))) out)
      (assert-true (array-is out 'double-float 2 '(3d0 4d0))))
    (assert-equal -4 (funcall (compile nil '(lambda () (funcall #'- 1 2 3)))))
    (assert-equal 6 (funcall (compile nil '(lambda () (apply #'* '(1 2 3))))))
    (assert-equal 1/6 (funcall (compile nil '(lambda () (funcall #'/ 6))) ))))

(deftest cm-other-operators-evaluation-order (compiler-macro-tests)
  (dolist (pair (list (list (compile nil '(lambda (x) (- x (incf x) (incf x))))
                            (compile nil '(lambda (x) (cl:- x (cl:incf x) (cl:incf x)))))
                      (list (compile nil '(lambda (x) (* x (incf x) (incf x))))
                            (compile nil '(lambda (x) (cl:* x (cl:incf x) (cl:incf x)))))
                      (list (compile nil '(lambda (x) (/ x (incf x) (incf x))))
                            (compile nil '(lambda (x) (cl:/ x (cl:incf x) (cl:incf x)))))))
    (assert-equal (funcall (second pair) 1) (funcall (first pair) 1)))
  (let ((f (compile nil '(lambda (x)
                          (let ((trace '()))
                            (let ((r (- (progn (push 1 trace) x)
                                        (progn (push 2 trace) 10)
                                        (progn (push 3 trace) 100))))
                              (list r (reverse trace))))))))
    (assert-equal '(-109 (1 2 3)) (funcall f 1)))
  (let ((f (compile nil '(lambda (x) (let ((n 0)) (list (/ (progn (incf n) x) (progn (incf n) 2)) n))))))
    (assert-equal '(1/2 2) (funcall f 1)))
  ;; array first argument followed by a side effect on the variable holding it
  (let ((a (darr 1d0 2d0)))
    (assert-true (array-is (funcall (compile nil '(lambda (v) (- v (progn (setq v 5) 1)))) a)
                           'double-float 2 '(0d0 1d0)))))

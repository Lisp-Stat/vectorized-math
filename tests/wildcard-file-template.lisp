;;; Template compiled by tests/wildcard.lisp with COMPILE-FILE twice, once with @PKG@ a package
;;; shadowing-importing (vm:shadowed-symbols) and once with a plain package.  RUN-CHECKS returns the printed
;;; results, which must be the same in both.
(in-package :@PKG@)
(deftype vec2 (&optional (n '*)) `(simple-array double-float (,n)))
(declaim (ftype (function (fixnum) *) g1) (ftype (function (&rest t) *) g2)
         (ftype (function ((simple-array double-float (*))) double-float) g3))
(defun g1 (x) x)
(defun g2 (&rest x) x)
(defun g3 (v) (declare (type (simple-array double-float (*)) v) (optimize (speed 1) (safety 0)))
  (let ((s 0d0)) (declare (double-float s))
    (dotimes (i (length v) s) (incf s (aref v i)))))
(defun g4 (x) (the (simple-array fixnum (*)) x))
(defun g5 (x) (typep x '(simple-array double-float (*))))
(defun g6 (x ty) (typep x ty))
(defun g7 (x) (typecase x ((simple-array double-float (*)) :d) ((array * (2 2)) :m22) ((vector *) :v) (t :other)))
(defun g8 (x) (etypecase x ((vec2 3) :d3) ((vec2) :dany)))
(defun g9 (x) (check-type x (simple-array single-float (*))) x)
(defun g10 (x) (the (values fixnum *) (values x 1)))
(defun g11 (n) (make-array n :element-type 'double-float))
(defun g12 (l) (coerce l '(simple-array single-float (*))))
(defstruct fs (d (make-array 2 :element-type 'double-float) :type (simple-array double-float (*))))
(defclass fc () ((s :type (simple-array double-float (*)) :initarg :s :initform (make-array 1 :element-type 'double-float))))
(defun g13 (x) (typep x '(array * (2 2))))
(defun g14 (x) (typep x '(vector *)))
(defun g15 (x) (typep x '(vec2)))
(defun g16 (x) (typep x '(vec2 3)))
(defun g17 (x) (typep x '(integer 0 *)))

(defmacro chk (form)
  `(handler-case (format nil "~S => ~S" ',form (multiple-value-list ,form))
     (error (e) (format nil "~S => ERROR ~A" ',form (substitute #\Space #\Newline (princ-to-string e))))))

(defun run-checks ()
  (let ((d (make-array 3 :element-type 'double-float :initial-element 1d0))
        (f (make-array 3 :element-type 'fixnum)) (s (make-array 3 :element-type 'single-float))
        (m (make-array '(2 2))))
    (list
     (chk (g1 1)) (chk (g2 1 2)) (chk (g3 d)) (chk (g4 f)) (chk (g5 d)) (chk (g5 f))
     (chk (g6 d '(simple-array double-float (*)))) (chk (g6 d '(simple-array double-float (3))))
     (chk (g7 d)) (chk (g7 m)) (chk (g7 (make-array 2))) (chk (g7 5))
     (chk (g8 d)) (chk (g8 (make-array 4 :element-type 'double-float))) (chk (g9 s)) (chk (g9 d))
     (chk (g10 7)) (chk (type-of (g11 4))) (chk (type-of (g12 '(1.0 2.0))))
     (chk (type-of (fs-d (make-fs)))) (chk (make-fs :d 5))
     (chk (type-of (slot-value (make-instance 'fc) 's)))
     (chk (g13 m)) (chk (g14 (make-array 2))) (chk (g15 d)) (chk (g16 d)) (chk (g17 5)) (chk (g17 -5))
     (chk (g4 d)))))

(in-package #:vm-tests)

(defsuite into-tests (vm-tests))

(defun dzeros (n) (make-array n :element-type 'double-float :initial-element 0d0))

(deftest into-size-match (into-tests)
  (let ((out (dzeros 3)))
    (with-warnings (r ws) (+ (darr 1d0 2d0 3d0) (darr 10d0 20d0 30d0) :into out)
      (assert-true (eq r out))
      (assert-true (array-is out 'double-float 3 '(11d0 22d0 33d0)))
      (assert-equal nil ws))))

(deftest into-recycle-and-warn (into-tests)
  (let ((out (dzeros 4)))
    (with-warnings (r ws) (+ (darr 1d0 2d0) 0d0 :into out)
      (assert-true (array-is out 'double-float 4 '(1d0 2d0 1d0 2d0)))
      (assert-equal nil ws)))
  (let ((out (dzeros 4)))
    (with-warnings (r ws) (+ (darr 1d0 2d0 3d0) 0d0 :into out)
      (assert-true (array-is out 'double-float 4 '(1d0 2d0 3d0 1d0)))
      (assert-equal 1 (length (recycling-warnings ws))))))

(deftest into-truncate-and-warn (into-tests)
  (let ((out (dzeros 2)))
    (with-warnings (r ws) (+ (darr 1d0 2d0 3d0 4d0) 0d0 :into out)
      (assert-true (array-is out 'double-float 2 '(1d0 2d0)))
      (assert-equal 1 (length (recycling-warnings ws))))))

(deftest into-widening-ok (into-tests)
  (let ((out (dzeros 2)))
    (+ (sarr 1f0 2f0) 0f0 :into out)
    (assert-true (array-is out 'double-float 2 '(1d0 2d0))))
  (let ((out (make-array 2 :element-type '(complex double-float) :initial-element #c(0d0 0d0))))
    (+ (darr 1d0 2d0) 0d0 :into out)
    (assert-true (array-is out '(complex double-float) 2 '(#c(1d0 0d0) #c(2d0 0d0)))))
  (let ((out (make-array 2 :element-type '(complex double-float) :initial-element #c(0d0 0d0))))
    (+ (csarr #c(1f0 2f0) #c(3f0 4f0)) 0 :into out)
    (assert-true (array-is out '(complex double-float) 2 '(#c(1d0 2d0) #c(3d0 4d0)))))
  (let ((out (dzeros 3)))
    (+ (iarr '(unsigned-byte 8) 1 2 3) 1 :into out)
    (assert-true (array-is out 'double-float 3 '(2d0 3d0 4d0))))
  (let ((out (make-array 3)))
    (+ (iarr '(unsigned-byte 8) 1 2 3) 1/2 :into out)
    (assert-equal '(3/2 5/2 7/2) (contents out)))
  (let ((out (make-array 2 :element-type '(signed-byte 64) :initial-element 0)))
    (+ (iarr '(unsigned-byte 8) 1 2) 1 :into out)
    (assert-true (array-is out '(signed-byte 64) 2 '(2 3)))))

(deftest into-narrowing-errors (into-tests)
  (flet ((check (result-form out)
           (let* ((before (copy-arr out)) (c (condition-of (funcall result-form out))))
             (list (typep c 'vm:output-type-error) (typep c 'type-error) (same-contents-p out before)))))
    (assert-equal '(t t t) (check (lambda (o) (+ (darr 1d0 2d0) 0d0 :into o)) (make-array 2 :element-type 'single-float)))
    (assert-equal '(t t t) (check (lambda (o) (+ (cdarr #c(1d0 1d0)) 0 :into o)) (dzeros 1)))
    (assert-equal '(t t t) (check (lambda (o) (+ (darr 1d0 2d0) 0 :into o)) (make-array 2 :element-type '(signed-byte 64))))
    (assert-equal '(t t t) (check (lambda (o) (+ (sarr 1f0 2f0) 0 :into o)) (make-array 2 :element-type '(unsigned-byte 8))))
    (assert-equal '(t t t) (check (lambda (o) (+ (iarr '(unsigned-byte 8) 200 100) 100 :into o))
                                  (make-array 2 :element-type '(unsigned-byte 8))))
    (assert-equal '(t t t) (check (lambda (o) (+ (iarr '(unsigned-byte 8) 1 2) 1/2 :into o))
                                  (make-array 2 :element-type '(unsigned-byte 8))))
    (assert-equal '(t t t) (check (lambda (o) (+ 1d0 2 :into o)) (make-array 2 :element-type 'single-float)))
    (assert-equal '(t t t) (check (lambda (o) (+ 1d0 2 :into o)) (make-array 2 :element-type '(unsigned-byte 8))))
    (assert-equal '(t t t) (check (lambda (o) (+ (darr 1d0) 0 :into o))
                                  (make-array 2 :element-type 'character :initial-element #\a))))
  ;; integer values that fit the narrower output are fine
  (let ((out (make-array 2 :element-type '(unsigned-byte 8))))
    (+ (iarr '(signed-byte 32) 100 20) 5 :into out)
    (assert-true (array-is out '(unsigned-byte 8) 2 '(105 25)))))

(deftest into-aliasing (into-tests)
  (let ((a (darr 1d0 2d0 3d0)) (b (darr 10d0 20d0 30d0)))
    (assert-true (eq a (+ a b :into a)))
    (assert-true (array-is a 'double-float 3 '(11d0 22d0 33d0)))
    (assert-true (array-is b 'double-float 3 '(10d0 20d0 30d0))))
  (let ((a (darr 1d0 2d0 3d0)))
    (+ a a :into a)
    (assert-true (array-is a 'double-float 3 '(2d0 4d0 6d0))))
  (let ((a (darr 1d0 2d0 3d0 4d0)))
    (+ a (darr 10d0 20d0) :into a)
    (assert-true (array-is a 'double-float 4 '(11d0 22d0 13d0 24d0))))
  (let ((b (darr 10d0 20d0)) (out (darr 1d0 2d0 3d0 4d0)))
    ;; out is the recycled (shorter) operand's partner: shifted aliasing of values must not matter
    (+ out b :into b)
    (assert-true (array-is b 'double-float 2 '(11d0 22d0))))
  (let ((a (darr 1d0 2d0 3d0)))
    (+ a 1d0 2d0 :into a)
    (assert-true (array-is a 'double-float 3 '(4d0 5d0 6d0)))))

(deftest into-multidimensional-column-major (into-tests)
  "Hand-computed.  Out 2x3, value #(1..6): out is filled in column-major order, so
out[i,j] = v[i+2j]: row 0 = v0 v2 v4 = 1 3 5, row 1 = v1 v3 v5 = 2 4 6."
  (let ((out (make-array '(2 3) :element-type 'double-float :initial-element 0d0)))
    (+ (darr 1d0 2d0 3d0 4d0 5d0 6d0) 0d0 :into out)
    (assert-true (array-is out 'double-float '(2 3) '(1d0 3d0 5d0 2d0 4d0 6d0))))
  ;; matrix value into a matrix: position by position
  (let ((out (make-array '(2 3) :element-type 'double-float :initial-element 0d0)))
    (+ (mat23) 1d0 :into out)
    (assert-true (array-is out 'double-float '(2 3) '(2d0 3d0 4d0 5d0 6d0 7d0))))
  ;; matrix value into a vector: column-major order of the matrix, 1 4 2 5 3 6
  (let ((out (dzeros 6)))
    (+ (mat23) 0d0 :into out)
    (assert-true (array-is out 'double-float 6 '(1d0 4d0 2d0 5d0 3d0 6d0))))
  ;; length-2 vector recycled over a 2x3 out: out[i,j] = v[i]
  (let ((out (make-array '(2 3) :element-type 'double-float :initial-element 0d0)))
    (with-warnings (r ws) (+ (darr 7d0 8d0) 0d0 :into out)
      (assert-true (array-is out 'double-float '(2 3) '(7d0 7d0 7d0 8d0 8d0 8d0)))
      (assert-equal nil ws)))
  ;; matrix + vector computed, stored into another matrix
  (let ((out (make-array '(2 3) :element-type 'double-float :initial-element 0d0)))
    (+ (mat23) (darr 10d0 20d0) :into out)
    (assert-true (array-is out 'double-float '(2 3) '(11d0 12d0 13d0 24d0 25d0 26d0)))))

(deftest into-all-scalars (into-tests)
  (let ((out (dzeros 3)))
    (with-warnings (r ws) (+ 1 2 :into out)
      (assert-true (array-is out 'double-float 3 '(3d0 3d0 3d0)))
      (assert-equal nil ws)))
  (let ((out (make-array '(2 2) :element-type '(unsigned-byte 8) :initial-element 0)))
    (+ 1 2 3 :into out)
    (assert-true (array-is out '(unsigned-byte 8) '(2 2) '(6 6 6 6))))
  (let ((out (make-array 2)))
    (+ 1/2 1/3 :into out)
    (assert-equal '(5/6 5/6) (contents out))))

(deftest into-single-operand-and-misc (into-tests)
  (let ((out (dzeros 3)))
    (+ (darr 1d0 2d0 3d0) :into out)
    (assert-true (array-is out 'double-float 3 '(1d0 2d0 3d0))))
  ;; fill-pointer out: total size is used
  (let ((out (make-array 4 :element-type 'double-float :fill-pointer 2 :initial-element 0d0)))
    (+ (darr 1d0 2d0 3d0 4d0) 1d0 :into out)
    (assert-equal '(2d0 3d0 4d0 5d0) (loop for i below 4 collect (row-major-aref out i)))))

(deftest into-placement-and-type (into-tests)
  (let ((out (dzeros 2)))
    ;; :into not second-to-last: ordinary operand, TYPE-ERROR for the keyword as CL gives
    (dolist (thunk (list (lambda () (+ (darr 1d0 2d0) :into out (darr 1d0 2d0)))
                         (lambda () (+ :into out))
                         (lambda () (+ (darr 1d0 2d0) :into))
                         (lambda () (+ :into (darr 1d0 2d0) out))))
      (let ((c (condition-of (funcall thunk))))
        (assert-true (typep c 'type-error))
        (assert-eq :into (type-error-datum c))
        (assert-equal 'number (type-error-expected-type c))))
    (assert-true (same-contents-p out (dzeros 2)))
    ;; out must be an array
    (let ((c (condition-of (+ (darr 1d0 2d0) 1d0 :into 5))))
      (assert-true (typep c 'type-error))
      (assert-eql 5 (type-error-datum c)))
    (let ((c (condition-of (+ (darr 1d0 2d0) 1d0 :into '(1 2)))))
      (assert-true (typep c 'type-error)))))

(deftest into-zero-length (into-tests)
  (let ((out (dzeros 0)))
    (assert-true (eq out (+ (darr 1d0) 1d0 :into out))))
  (let ((out (dzeros 2)))
    (assert-true (typep (condition-of (+ (darr) 1d0 :into out)) 'vm:non-conformable-arrays))))

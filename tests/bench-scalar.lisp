;;; Scalar benchmark and disassembly comparison for the compiler macros of VM:+ - * / 1+ 1-.
;;; Run:  sbcl --no-userinit --non-interactive --load tests/bench-scalar.lisp
;;;       ccl --no-init --batch --load tests/bench-scalar.lisp --eval '(ccl:quit)' </dev/null
;;; Not part of the clunit suite.
(load "/home/vscode/quicklisp/setup.lisp")
(push (merge-pathnames "../" (make-pathname :name nil :type nil :defaults *load-truename*))
      asdf:*central-registry*)
(asdf:load-system :vectorized-math)

(defpackage #:vm-bench
  (:use #:cl)
  (:shadowing-import-from #:vm . #.(mapcar #'symbol-name (vm:shadowed-symbols))))
(in-package #:vm-bench)

(defmacro def-loops (op suffix)
  "Elementwise loops over two input vectors of each kind with binary OP, plus unary
loops with OP (when it takes one argument)."
  (flet ((nm (kind) (intern (format nil "~A-~A" kind suffix))))
    `(progn
       (defun ,(nm "FIXNUM") (v w out n)
         (declare (type (simple-array fixnum (*)) v w out) (fixnum n) (optimize (speed 1) (safety 1)))
         (dotimes (i n) (setf (aref out i) (the fixnum (,op (aref v i) (aref w i))))))
       (defun ,(nm "DOUBLE") (v w out n)
         (declare (type (simple-array double-float (*)) v w out) (fixnum n) (optimize (speed 1) (safety 1)))
         (dotimes (i n) (setf (aref out i) (,op (aref v i) (aref w i)))))
       (defun ,(nm "GENERIC") (v w out n)
         (declare (simple-vector v w out) (fixnum n) (optimize (speed 1) (safety 1)))
         (dotimes (i n) (setf (svref out i) (,op (svref v i) (svref w i)))))
       (defun ,(nm "GENERIC-DOUBLE") (v w out n)
         (declare (simple-vector v w out) (fixnum n) (optimize (speed 1) (safety 1)))
         (dotimes (i n) (setf (svref out i) (,op (svref v i) (svref w i))))))))

(defmacro def-unary-loops (op suffix)
  (flet ((nm (kind) (intern (format nil "U-~A-~A" kind suffix))))
    `(progn
       (defun ,(nm "DOUBLE") (v out n)
         (declare (type (simple-array double-float (*)) v out) (fixnum n) (optimize (speed 1) (safety 1)))
         (dotimes (i n) (setf (aref out i) (,op (aref v i)))))
       (defun ,(nm "GENERIC") (v out n)
         (declare (simple-vector v out) (fixnum n) (optimize (speed 1) (safety 1)))
         (dotimes (i n) (setf (svref out i) (,op (svref v i))))))))

(def-loops cl:+ plus-cl)   (def-loops vm:+ plus-vm)
(def-loops cl:- minus-cl)  (def-loops vm:- minus-vm)
(def-loops cl:* times-cl)  (def-loops vm:* times-vm)
(def-loops cl:/ div-cl)    (def-loops vm:/ div-vm)
(def-unary-loops cl:- minus-cl) (def-unary-loops vm:- minus-vm)
(def-unary-loops cl:/ div-cl)   (def-unary-loops vm:/ div-vm)
(def-unary-loops cl:1+ inc-cl)  (def-unary-loops vm:1+ inc-vm)
(def-unary-loops cl:1- dec-cl)  (def-unary-loops vm:1- dec-vm)
(def-unary-loops cl:abs abs-cl)   (def-unary-loops vm:abs abs-vm)
(def-unary-loops cl:sqrt sqrt-cl) (def-unary-loops vm:sqrt sqrt-vm)
(def-unary-loops cl:exp exp-cl)   (def-unary-loops vm:exp exp-vm)
(def-unary-loops cl:sin sin-cl)   (def-unary-loops vm:sin sin-vm)

(defun now () (/ (get-internal-real-time) (float internal-time-units-per-second 1d0)))

(defun ns-per-op (thunk n)
  "Best of 7 runs, each at least ~0.15 s; nanoseconds per element."
  (let ((best nil))
    (dotimes (k 7)
      (let* ((reps 1) (dt 0d0))
        (loop
          (let ((t0 (now)))
            (dotimes (r reps) (funcall thunk))
            (setf dt (- (now) t0)))
          (when (> dt 0.15d0) (return))
          (setf reps (* reps 2)))
        (let ((ns (/ (* dt 1d9) (* reps n))))
          (when (or (null best) (< ns best)) (setf best ns)))))
    best))

(defun run-bench ()
  (let* ((n 100000)
         (vf (make-array n :element-type 'fixnum :initial-element 3))
         (wf (make-array n :element-type 'fixnum :initial-element 2))
         (of (make-array n :element-type 'fixnum :initial-element 0))
         (vd (make-array n :element-type 'double-float :initial-element 3.5d0))
         (wd (make-array n :element-type 'double-float :initial-element 2d0))
         (od (make-array n :element-type 'double-float :initial-element 0d0))
         (vg (make-array n :initial-element 3))
         (wg (make-array n :initial-element 2))
         (og (make-array n :initial-element 0))
         (vgd (make-array n :initial-element 3.5d0))
         (wgd (make-array n :initial-element 2d0)))
    (format t "~&~A ~A, ~D elements per run, best of 7 (ns per element)~%"
            (lisp-implementation-type) (lisp-implementation-version) n)
    (format t "~&~8A ~22A ~9A ~9A ~7A~%" "op" "loop" "cl" "vm" "vm/cl")
    (flet ((row (op loop cl-fn vm-fn &rest args)
             (let ((a (ns-per-op (lambda () (apply cl-fn args)) n))
                   (b (ns-per-op (lambda () (apply vm-fn args)) n)))
               (format t "~&~8A ~22A ~9,2F ~9,2F ~7,2F~%" op loop a b (/ b a)))))
      (dolist (spec '(("+" plus) ("-" minus) ("*" times) ("/" div)))
        (destructuring-bind (op stem) spec
          (flet ((f (kind side) (symbol-function (intern (format nil "~A-~A-~A" kind stem side)))))
            (unless (string= op "/")
              (row op "fixnum declared" (f "FIXNUM" "CL") (f "FIXNUM" "VM") vf wf of n))
            (row op "double declared" (f "DOUBLE" "CL") (f "DOUBLE" "VM") vd wd od n)
            (row op "generic (fixnums)" (f "GENERIC" "CL") (f "GENERIC" "VM") vg wg og n)
            (row op "generic (doubles)" (f "GENERIC-DOUBLE" "CL") (f "GENERIC-DOUBLE" "VM") vgd wgd og n))))
      (dolist (spec '(("-" minus) ("/" div) ("1+" inc) ("1-" dec)))
        (destructuring-bind (op stem) spec
          (flet ((f (kind side) (symbol-function (intern (format nil "U-~A-~A-~A" kind stem side)))))
            (row (format nil "~A (1 arg)" op) "double declared" (f "DOUBLE" "CL") (f "DOUBLE" "VM") vd od n)
            (row (format nil "~A (1 arg)" op) "generic (doubles)" (f "GENERIC" "CL") (f "GENERIC" "VM") vgd og n))))
      ;; operators (the loops store into a double array: sqrt of 3.5 is real)
      (dolist (spec '(("abs" abs) ("sqrt" sqrt) ("exp" exp) ("sin" sin)))
        (destructuring-bind (op stem) spec
          (flet ((f (kind side) (symbol-function (intern (format nil "U-~A-~A-~A" kind stem side)))))
            (row (format nil "~A (1 arg)" op) "double declared" (f "DOUBLE" "CL") (f "DOUBLE" "VM") vd od n)
            (row (format nil "~A (1 arg)" op) "generic (doubles)" (f "GENERIC" "CL") (f "GENERIC" "VM") vgd og n)))))))

(defun split-words (line)
  (let ((words '()) (start nil))
    (dotimes (i (length line))
      (let ((c (char line i)))
        (if (member c '(#\Space #\Tab))
            (when start (push (subseq line start i) words) (setf start nil))
            (unless start (setf start i)))))
    (when start (push (subseq line start) words))
    (nreverse words)))

(defun hex-word-p (w) (and (>= (length w) 2) (every (lambda (c) (digit-char-p c 16)) w)))

(defun normalize-line (line)
  "Instruction text of a disassembly LINE without addresses, machine-code bytes and comments."
  (let* ((cut (position #\; line :start (min (length line) (or (position-if-not (lambda (c) (member c '(#\Space #\;))) line) 0))))
         (words (split-words (subseq line 0 cut))))
    (setf words (remove ";" words :test #'string=))
    ;; leading "ADDR:" or "[ADDR]" offset
    (when (and words (let ((w (first words)))
                       (or (and (char= (char w (1- (length w))) #\:) (every (lambda (c) (digit-char-p c 16)) (subseq w 0 (1- (length w)))))
                           (and (char= (char w 0) #\[)))))
      (pop words))
    ;; optional label, then machine-code bytes
    (let ((label (and words (let ((w (first words))) (and (char= (char w (1- (length w))) #\:) (pop words))))))
      (when (and words (hex-word-p (first words))) (pop words))
      (format nil "~@[~A ~]~{~A~^ ~}" label words))))

(defun normalize-disassembly (fn)
  (let* ((text (with-output-to-string (*standard-output*) (disassemble fn)))
         (lines (loop with start = 0 for pos = (position #\Newline text :start start)
                      collect (subseq text start pos) while pos do (setf start (1+ pos)))))
    (loop for l in lines
          for n = (normalize-line l)
          unless (or (zerop (length n)) (search "disassembl" n :test (function char-equal)) (search "Origin" n)
                     (search "Function" n :test #'char-equal) (search "compiled" n :test #'char-equal))
            collect n)))

(defun compare-disassembly (name lambda-list decls body-cl body-vm)
  (let* ((f1 (compile nil `(lambda ,lambda-list (declare ,@decls) ,body-cl)))
         (f2 (compile nil `(lambda ,lambda-list (declare ,@decls) ,body-vm)))
         (d1 (normalize-disassembly f1)) (d2 (normalize-disassembly f2)))
    (format t "~&~A: cl ~D lines, vm ~D lines, ~A~%" name (length d1) (length d2)
            (if (equal d1 d2) "IDENTICAL after normalization" "DIFFERENT"))
    (unless (equal d1 d2)
      (loop for a in d1 for b in d2 for i from 0 unless (equal a b) do (format t "  ~D: ~A | ~A~%" i a b)))
    (equal d1 d2)))

(defun run-disassembly ()
  (let ((all t))
    (flet ((cmp (&rest args) (unless (apply #'compare-disassembly args) (setf all nil))))
      (dolist (pair '((cl:+ vm:+) (cl:- vm:-) (cl:* vm:*) (cl:/ vm:/)))
        (destructuring-bind (c v) pair
          (let ((n (symbol-name c)))
            (cmp (format nil "~A (fixnum fixnum)" n) '(a b) '((fixnum a b)) `(,c a b) `(,v a b))
            (cmp (format nil "~A (double double)" n) '(a b) '((double-float a b)) `(,c a b) `(,v a b))
            (cmp (format nil "~A (fixnum fixnum fixnum)" n) '(a b c) '((fixnum a b c)) `(,c a b c) `(,v a b c))
            (cmp (format nil "~A (double) 1 arg" n) '(a) '((double-float a)) `(,c a) `(,v a))
            (cmp (format nil "~A (fixnum) 1 arg" n) '(a) '((fixnum a)) `(,c a) `(,v a))
            (cmp (format nil "~A (the fixnum ..)" n) '(a b) '() `(,c (the fixnum a) (the fixnum b))
                 `(,v (the fixnum a) (the fixnum b))))))
      (dolist (pair '((cl:1+ vm:1+) (cl:1- vm:1-)))
        (destructuring-bind (c v) pair
          (let ((n (symbol-name c)))
            (cmp (format nil "~A (fixnum)" n) '(a) '((fixnum a)) `(,c a) `(,v a))
            (cmp (format nil "~A (double)" n) '(a) '((double-float a)) `(,c a) `(,v a)))))
      ;; operators that CL inlines for declared types, and a few that it does not
      (dolist (pair '((cl:abs vm:abs) (cl:sqrt vm:sqrt) (cl:exp vm:exp) (cl:sin vm:sin) (cl:cos vm:cos)
                      (cl:log vm:log) (cl:signum vm:signum) (cl:phase vm:phase) (cl:atan vm:atan)))
        (destructuring-bind (c v) pair
          (let ((n (symbol-name c)))
            (cmp (format nil "~A (double)" n) '(a) '((double-float a)) `(,c a) `(,v a))
            (cmp (format nil "~A (fixnum)" n) '(a) '((fixnum a)) `(,c a) `(,v a))
            (cmp (format nil "~A (the double-float ..)" n) '(a) '() `(,c (the double-float a)) `(,v (the double-float a))))))
      (cmp "abs (complex double)" '(a) '((type (complex double-float) a)) '(cl:abs a) '(vm:abs a))
      (cmp "realpart (complex double)" '(a) '((type (complex double-float) a)) '(cl:realpart a) '(vm:realpart a))
      (cmp "imagpart (complex double)" '(a) '((type (complex double-float) a)) '(cl:imagpart a) '(vm:imagpart a))
      (cmp "conjugate (complex double)" '(a) '((type (complex double-float) a)) '(cl:conjugate a) '(vm:conjugate a))
      (cmp "expt (double fixnum)" '(a b) '((double-float a) (fixnum b)) '(cl:expt a b) '(vm:expt a b))
      (cmp "expt (double double)" '(a b) '((double-float a b)) '(cl:expt a b) '(vm:expt a b))
      (cmp "atan (double double)" '(a b) '((double-float a b)) '(cl:atan a b) '(vm:atan a b))
      (cmp "log (double double)" '(a b) '((double-float a b)) '(cl:log a b) '(vm:log a b))
      (cmp "complex (double double)" '(a b) '((double-float a b)) '(cl:complex a b) '(vm:complex a b))
      (cmp "isqrt (fixnum)" '(a) '((type (integer 0 #.most-positive-fixnum) a)) '(cl:isqrt a) '(vm:isqrt a))
      ;; comparisons, max and min (n-ary too), predicates
      (dolist (pair '((cl:= vm:=) (cl:/= vm:/=) (cl:< vm:<) (cl:> vm:>) (cl:<= vm:<=) (cl:>= vm:>=)
                      (cl:max vm:max) (cl:min vm:min)))
        (destructuring-bind (c v) pair
          (let ((n (symbol-name c)))
            (cmp (format nil "~A (fixnum fixnum)" n) '(a b) '((fixnum a b)) `(,c a b) `(,v a b))
            (cmp (format nil "~A (double double)" n) '(a b) '((double-float a b)) `(,c a b) `(,v a b))
            (cmp (format nil "~A (single single)" n) '(a b) '((single-float a b)) `(,c a b) `(,v a b))
            (cmp (format nil "~A (fixnum fixnum fixnum)" n) '(a b c) '((fixnum a b c)) `(,c a b c) `(,v a b c))
            (cmp (format nil "~A (double double double)" n) '(a b c) '((double-float a b c)) `(,c a b c) `(,v a b c))
            (cmp (format nil "~A (the fixnum ..)" n) '(a b) '() `(,c (the fixnum a) (the fixnum b))
                 `(,v (the fixnum a) (the fixnum b)))
            (cmp (format nil "~A (double, constant)" n) '(a) '((double-float a)) `(,c a 0d0) `(,v a 0d0)))))
      (dolist (pair '((cl:zerop vm:zerop) (cl:plusp vm:plusp) (cl:minusp vm:minusp)))
        (destructuring-bind (c v) pair
          (let ((n (symbol-name c)))
            (cmp (format nil "~A (double)" n) '(a) '((double-float a)) `(,c a) `(,v a))
            (cmp (format nil "~A (fixnum)" n) '(a) '((fixnum a)) `(,c a) `(,v a))
            (cmp (format nil "~A (single)" n) '(a) '((single-float a)) `(,c a) `(,v a)))))
      (dolist (pair '((cl:evenp vm:evenp) (cl:oddp vm:oddp)))
        (destructuring-bind (c v) pair
          (let ((n (symbol-name c)))
            (cmp (format nil "~A (fixnum)" n) '(a) '((fixnum a)) `(,c a) `(,v a))
            (cmp (format nil "~A (integer)" n) '(a) '((integer a)) `(,c a) `(,v a)))))
      ;; division and rounding (two values), mod, rem, gcd, lcm
      (dolist (pair '((cl:floor vm:floor) (cl:ceiling vm:ceiling) (cl:truncate vm:truncate) (cl:round vm:round)
                      (cl:ffloor vm:ffloor) (cl:fceiling vm:fceiling) (cl:ftruncate vm:ftruncate)
                      (cl:fround vm:fround) (cl:mod vm:mod) (cl:rem vm:rem)))
        (destructuring-bind (c v) pair
          (let ((n (symbol-name c)))
            (cmp (format nil "~A (fixnum fixnum)" n) '(a b) '((fixnum a b)) `(,c a b) `(,v a b))
            (cmp (format nil "~A (double double)" n) '(a b) '((double-float a b)) `(,c a b) `(,v a b))
            (cmp (format nil "~A (single single)" n) '(a b) '((single-float a b)) `(,c a b) `(,v a b))
            (cmp (format nil "~A (double fixnum)" n) '(a b) '((double-float a) (fixnum b)) `(,c a b) `(,v a b))
            (cmp (format nil "~A (the fixnum ..)" n) '(a b) '() `(,c (the fixnum a) (the fixnum b))
                 `(,v (the fixnum a) (the fixnum b)))
            (cmp (format nil "~A (double, constant)" n) '(a) '((double-float a)) `(,c a 2d0) `(,v a 2d0))
            (cmp (format nil "~A (integer integer)" n) '(a b) '((integer a b)) `(,c a b) `(,v a b))
            (unless (member n '("MOD" "REM") :test #'string=)
              (cmp (format nil "~A (double) 1 arg" n) '(a) '((double-float a)) `(,c a) `(,v a))
              (cmp (format nil "~A (fixnum) 1 arg" n) '(a) '((fixnum a)) `(,c a) `(,v a))))))
      (dolist (pair '((cl:gcd vm:gcd) (cl:lcm vm:lcm)))
        (destructuring-bind (c v) pair
          (let ((n (symbol-name c)))
            (cmp (format nil "~A (fixnum fixnum)" n) '(a b) '((fixnum a b)) `(,c a b) `(,v a b))
            (cmp (format nil "~A (fixnum fixnum fixnum)" n) '(a b c) '((fixnum a b c)) `(,c a b c) `(,v a b c))
            (cmp (format nil "~A (integer integer)" n) '(a b) '((integer a b)) `(,c a b) `(,v a b))
            (cmp (format nil "~A (the fixnum ..)" n) '(a b) '() `(,c (the fixnum a) (the fixnum b))
                 `(,v (the fixnum a) (the fixnum b)))
            (cmp (format nil "~A (fixnum) 1 arg" n) '(a) '((fixnum a)) `(,c a) `(,v a)))))
      ;; bitwise, shifts, bit tests, conversions
      (dolist (pair '((cl:logand vm:logand) (cl:logior vm:logior) (cl:logxor vm:logxor) (cl:logeqv vm:logeqv)))
        (destructuring-bind (c v) pair
          (let ((n (symbol-name c)))
            (cmp (format nil "~A (fixnum fixnum)" n) '(a b) '((fixnum a b)) `(,c a b) `(,v a b))
            (cmp (format nil "~A (fixnum fixnum fixnum)" n) '(a b c) '((fixnum a b c)) `(,c a b c) `(,v a b c))
            (cmp (format nil "~A (integer integer)" n) '(a b) '((integer a b)) `(,c a b) `(,v a b))
            (cmp (format nil "~A (signed-byte 64 ..)" n) '(a b) '((type (signed-byte 64) a b)) `(,c a b) `(,v a b))
            (cmp (format nil "~A (the fixnum ..)" n) '(a b) '() `(,c (the fixnum a) (the fixnum b))
                 `(,v (the fixnum a) (the fixnum b)))
            (cmp (format nil "~A (fixnum, constant)" n) '(a) '((fixnum a)) `(,c a 255) `(,v a 255))
            (cmp (format nil "~A (fixnum) 1 arg" n) '(a) '((fixnum a)) `(,c a) `(,v a)))))
      (dolist (pair '((cl:lognand vm:lognand) (cl:lognor vm:lognor) (cl:logandc1 vm:logandc1) (cl:logandc2 vm:logandc2)
                      (cl:logorc1 vm:logorc1) (cl:logorc2 vm:logorc2) (cl:logtest vm:logtest)))
        (destructuring-bind (c v) pair
          (let ((n (symbol-name c)))
            (cmp (format nil "~A (fixnum fixnum)" n) '(a b) '((fixnum a b)) `(,c a b) `(,v a b))
            (cmp (format nil "~A (integer integer)" n) '(a b) '((integer a b)) `(,c a b) `(,v a b))
            (cmp (format nil "~A (the fixnum ..)" n) '(a b) '() `(,c (the fixnum a) (the fixnum b))
                 `(,v (the fixnum a) (the fixnum b))))))
      (dolist (pair '((cl:lognot vm:lognot) (cl:logcount vm:logcount) (cl:integer-length vm:integer-length)))
        (destructuring-bind (c v) pair
          (let ((n (symbol-name c)))
            (cmp (format nil "~A (fixnum)" n) '(a) '((fixnum a)) `(,c a) `(,v a))
            (cmp (format nil "~A (integer)" n) '(a) '((integer a)) `(,c a) `(,v a))
            (cmp (format nil "~A (signed-byte 64)" n) '(a) '((type (signed-byte 64) a)) `(,c a) `(,v a))
            (cmp (format nil "~A (the fixnum ..)" n) '(a) '() `(,c (the fixnum a)) `(,v (the fixnum a))))))
      (cmp "ash (fixnum, (integer -20 20))" '(a b) '((fixnum a) (type (integer -20 20) b)) '(cl:ash a b) '(vm:ash a b))
      (cmp "ash (integer fixnum)" '(a b) '((integer a) (fixnum b)) '(cl:ash a b) '(vm:ash a b))
      (cmp "ash (fixnum, constant 3)" '(a) '((fixnum a)) '(cl:ash a 3) '(vm:ash a 3))
      (cmp "ash (fixnum, constant -3)" '(a) '((fixnum a)) '(cl:ash a -3) '(vm:ash a -3))
      (cmp "ash (the fixnum ..)" '(a b) '() '(cl:ash (the fixnum a) (the (integer -20 20) b)) '(vm:ash (the fixnum a) (the (integer -20 20) b)))
      (cmp "logbitp ((integer 0 62) fixnum)" '(a b) '((type (integer 0 62) a) (fixnum b)) '(cl:logbitp a b) '(vm:logbitp a b))
      (cmp "logbitp (fixnum integer)" '(a b) '((type unsigned-byte a) (integer b)) '(cl:logbitp a b) '(vm:logbitp a b))
      (cmp "logbitp (constant 3, fixnum)" '(b) '((fixnum b)) '(cl:logbitp 3 b) '(vm:logbitp 3 b))
      (cmp "float (fixnum) 1 arg" '(a) '((fixnum a)) '(cl:float a) '(vm:float a))
      (cmp "float (double) 1 arg" '(a) '((double-float a)) '(cl:float a) '(vm:float a))
      (cmp "float (single) 1 arg" '(a) '((single-float a)) '(cl:float a) '(vm:float a))
      (cmp "float (integer) 1 arg" '(a) '((integer a)) '(cl:float a) '(vm:float a))
      (cmp "float (rational) 1 arg" '(a) '((rational a)) '(cl:float a) '(vm:float a))
      (cmp "float (fixnum, double)" '(a b) '((fixnum a) (double-float b)) '(cl:float a b) '(vm:float a b))
      (cmp "float (fixnum, constant 1d0)" '(a) '((fixnum a)) '(cl:float a 1d0) '(vm:float a 1d0))
      (cmp "float (double, constant 1f0)" '(a) '((double-float a)) '(cl:float a 1f0) '(vm:float a 1f0))
      (cmp "float (single, double)" '(a b) '((single-float a) (double-float b)) '(cl:float a b) '(vm:float a b))
      (cmp "float (the fixnum ..)" '(a) '() '(cl:float (the fixnum a)) '(vm:float (the fixnum a)))
      (dolist (pair '((cl:rational vm:rational) (cl:rationalize vm:rationalize)))
        (destructuring-bind (c v) pair
          (let ((n (symbol-name c)))
            (cmp (format nil "~A (double)" n) '(a) '((double-float a)) `(,c a) `(,v a))
            (cmp (format nil "~A (single)" n) '(a) '((single-float a)) `(,c a) `(,v a))
            (cmp (format nil "~A (fixnum)" n) '(a) '((fixnum a)) `(,c a) `(,v a))
            (cmp (format nil "~A (the double-float ..)" n) '(a) '() `(,c (the double-float a)) `(,v (the double-float a))))))
      (dolist (pair '((cl:numerator vm:numerator) (cl:denominator vm:denominator)))
        (destructuring-bind (c v) pair
          (let ((n (symbol-name c)))
            (cmp (format nil "~A (integer)" n) '(a) '((integer a)) `(,c a) `(,v a))
            (cmp (format nil "~A (fixnum)" n) '(a) '((fixnum a)) `(,c a) `(,v a))
            (cmp (format nil "~A (rational)" n) '(a) '((rational a)) `(,c a) `(,v a)))))
      (cmp "scale-float (double fixnum)" '(a b) '((double-float a) (fixnum b)) '(cl:scale-float a b) '(vm:scale-float a b))
      (cmp "scale-float (single fixnum)" '(a b) '((single-float a) (fixnum b)) '(cl:scale-float a b) '(vm:scale-float a b))
      (cmp "scale-float (double, constant 3)" '(a) '((double-float a)) '(cl:scale-float a 3) '(vm:scale-float a 3))
      (cmp "float-sign (double) 1 arg" '(a) '((double-float a)) '(cl:float-sign a) '(vm:float-sign a))
      (cmp "float-sign (single) 1 arg" '(a) '((single-float a)) '(cl:float-sign a) '(vm:float-sign a))
      (cmp "float-sign (double double)" '(a b) '((double-float a b)) '(cl:float-sign a b) '(vm:float-sign a b))
      (cmp "float-sign (single double)" '(a b) '((single-float a) (double-float b)) '(cl:float-sign a b) '(vm:float-sign a b)))
    (format t "~&DISASSEMBLY ~A~%" (if all "ALL IDENTICAL" "SOME DIFFERENT"))
    all))

(run-bench)
(run-disassembly)
